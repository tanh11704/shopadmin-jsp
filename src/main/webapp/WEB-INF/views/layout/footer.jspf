</c:if>
<script>
  window.SA_CONFIG = {
    ctx: '${ctx}',
    csrfToken: '${sessionScope.csrfToken}',
    demo: false
  };
</script>
<script src="${ctx}/assets/js/app.js"></script>
</body>
